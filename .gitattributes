# Generated verbatim from the pinned Ghostty source; preserve upstream bytes.
native/libghostty/prebuilt/*/include/ghostty/vt.h -whitespace

# Git patches are applied verbatim on Linux and Windows runners.
*.patch text eol=lf

# Compiled into the binary and fingerprinted: a CRLF checkout on Windows would
# install a different file from the same source and break its front matter check.
skills/**/SKILL.md text eol=lf
